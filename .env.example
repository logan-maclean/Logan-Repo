# Glean instance, e.g. "acme" if your backend is acme-be.glean.com
GLEAN_INSTANCE=your-instance

# Token with INDEXING scope (used to push Workhub docs into Glean)
GLEAN_INDEXING_TOKEN=

# Token with CHAT/SEARCH scope (used to ask Glean questions)
GLEAN_CLIENT_TOKEN=

# User to act as for Client API calls (Glean requires an "act-as" user
# unless the token is a global token).
GLEAN_ACT_AS_USER=user@example.com

# Datasource identifier registered in Glean for Workhub content
WORKHUB_DATASOURCE=workhub

# Workhub API config (fill in to match your environment)
WORKHUB_BASE_URL=https://workhub.example.com/api
WORKHUB_API_TOKEN=
